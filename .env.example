# Solana
HELIUS_API_KEY=
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
BIRDEYE_API_KEY=
SOLSCAN_API_KEY=

# EVM
BASESCAN_API_KEY=
BSCSCAN_API_KEY=

# No key needed: DexScreener, GeckoTerminal, CoinGecko (free), Jupiter

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Privy (Web3 Auth)
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Telegram: main Liège bot (interactive commands) ───────────────────────────
TELEGRAM_API_KEY=
TELEGRAM_WEBHOOK_SECRET=

# ── Telegram: Liège Alerts (private sister bot for push alerts) ────────────────
# Separate bot (create via @BotFather). All alert feeds — StonkFun, Sunrise,
# Robinhood Chain, BNB Chain (Four.meme + Flap), and future chains — are pushed
# through THIS bot, not the main one. Leave the token empty to disable alerts
# entirely (pollers still run).
TELEGRAM_ALERTS_API_KEY=
TELEGRAM_ALERTS_WEBHOOK_SECRET=
# Comma/space-separated Telegram chat IDs allowed to use the bot AND receive
# alerts (the allow-list). Start with just your own ID. If unset, falls back to
# the legacy *_ALERT_CHAT_ID vars below.
ALERTS_ALLOWLIST=

# Legacy single-target alert chat IDs (still honored as an allow-list fallback).
STONKFUN_ALERT_CHAT_ID=
LONG_ALERT_CHAT_ID=
SUNRISE_ALERT_CHAT_ID=
