# Research pipeline working files — regenerable caches, not deliverables.
# The dataset itself (data/rh-ath-2m-60d.json) and the watchlist ARE committed.
data/rh-candidates.json
data/rh-traders-cache.json
data/rh-contract-flags.json

# Tracked-wallet export for external terminals — a personal watchlist,
# regenerable at any time via scripts/export-tracked-wallets.ts.
data/tracked-wallets.json
data/tracked-wallets.jsonc
data/tracked-devs.json
data/tracked-devs.jsonc
